{
  "expo": {
    "name": "Unhittable",
    "slug": "unhittable",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "unhittable",
    "backgroundColor": "#08090a",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#08090a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stephensook.unhittable",
      "buildNumber": "1",
      "infoPlist": {
        "NSMotionUsageDescription": "Unhittable reads the accelerometer for ten seconds to measure how much your hand moves, so it can work out how large a button you need. The recording stays on this device and is never uploaded.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.stephensook.unhittable",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08090a"
      },
      "permissions": [
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ]
    }
  }
}
