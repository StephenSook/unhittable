# Postgres. Neon in production; any Postgres 14+ works.
# The API runs without it: live scanning still works and only the corpus
# endpoints report that they are unavailable.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Where the static site is served from, for CORS. Comma-separated.
ALLOWED_ORIGINS=https://stephensook.github.io,http://localhost:8080

PORT=8787
